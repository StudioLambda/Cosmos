# Local configuration overrides. Process environment variables take precedence.
# Use double underscores to represent nested configuration keys.

# Optional AES-GCM key. It must be 16, 24, or 32 raw bytes.
COSMOS__CRYPTO__AES__KEY=

# Optional ChaCha20-Poly1305 key. It must be exactly 32 raw bytes.
COSMOS__CRYPTO__CHACHA20__KEY=
